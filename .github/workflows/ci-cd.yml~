name: Demo AI App Monitoring Pipeline

on:
  push:
    branches:
      - master

jobs:
  build-deploy:
    runs-on: ubuntu-latest

    steps:

      - name: Checkout Source Code
        uses: actions/checkout@v4

      - name: Login to Docker Hub
        uses: docker/login-action@v3
        with:
          username: ${{ secrets.DOCKER_USERNAME }}
          password: ${{ secrets.DOCKER_PASSWORD }}

      - name: Build Docker Image
        run: |
          docker build -t ${{ secrets.DOCKER_USERNAME }}/ai-monitoring-app:${{ github.sha }} .
          docker tag ${{ secrets.DOCKER_USERNAME }}/ai-monitoring-app:${{ github.sha }} ${{ secrets.DOCKER_USERNAME }}/ai-monitoring-app:latest

      - name: Push Docker Images
        run: |
          docker push ${{ secrets.DOCKER_USERNAME }}/ai-monitoring-app:${{ github.sha }}
          docker push ${{ secrets.DOCKER_USERNAME }}/ai-monitoring-app:latest

      - name: Deploy Monitoring Stack
        uses: appleboy/ssh-action@v1.0.3
        with:
          host: ${{ secrets.SERVER_HOST }}
          username: ${{ secrets.SERVER_USERNAME }}
          key: ${{ secrets.SERVER_SSH_KEY }}
          script: |
            docker pull ${{ secrets.DOCKER_USERNAME }}/ai-monitoring-app:latest

            docker stop ai-app prometheus grafana metrics || true
            docker rm ai-app prometheus grafana metrics || true

